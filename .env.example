APP_NAME="Bel Zamora District Office"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Comma-separated previous APP_KEY values only during an approved key-rotation/re-encryption process.
APP_PREVIOUS_KEYS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bel_zamora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Prefer Redis when Laragon Redis is running. Fallbacks are commented below.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@belzamora.local"
MAIL_FROM_NAME="${APP_NAME}"

# Bel Zamora application settings
INQUIRY_RETENTION_DAYS=180
INQUIRY_STAFF_NOTIFICATION_EMAIL=
INQUIRY_UNANSWERED_SLA_HOURS=48
# Filament approved-media upload limit in kilobytes (5120 = 5 MB).
APPROVED_MEDIA_MAX_KB=5120
# Public read-service cache TTL in seconds (invalidated on publish/edit).
PUBLIC_CONTENT_CACHE_TTL=60
# Queue retry defaults for FlagStaleContent and inquiry/mail notifications.
QUEUE_JOB_TRIES=3
QUEUE_JOB_BACKOFF=60
QUEUE_JOB_TIMEOUT=120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local fallback when Redis is not running:
# CACHE_STORE=file
# QUEUE_CONNECTION=database
