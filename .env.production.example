APP_NAME="Bel Zamora District Office"
APP_ENV=production
# Generate once and store in the secret manager.
# Never rotate casually: encrypted inquiry PII depends on a stable APP_KEY.
APP_KEY=
# Comma-separated previous keys only during an approved key-rotation/re-encryption process.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://www.belzamora.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.belzamora.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Default disk for generic storage. Approved media uploads explicitly use the "public" disk.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Bel Zamora application settings
INQUIRY_RETENTION_DAYS=180
INQUIRY_STAFF_NOTIFICATION_EMAIL=
INQUIRY_UNANSWERED_SLA_HOURS=48
# Filament approved-media upload limit in kilobytes (5120 = 5 MB).
APPROVED_MEDIA_MAX_KB=5120
# Public read-service cache TTL in seconds (invalidated on publish/edit).
PUBLIC_CONTENT_CACHE_TTL=60
# Queue retry defaults for FlagStaleContent and inquiry/mail notifications.
QUEUE_JOB_TRIES=3
QUEUE_JOB_BACKOFF=60
QUEUE_JOB_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"

# Ops reminders (see docs/PRODUCTION_OPS.md):
# - Supervise: php artisan queue:work redis --tries=3 --backoff=60
# - Cron every minute: php artisan schedule:run
# - Monitor failed_jobs via queue:check-failed (hourly) and queue:failed
# - Horizon is optional later if multi-queue visibility is needed; current single Redis worker is enough for MVP
# - Keep APP_KEY stable for encrypted inquiry columns
# - After deploy: php artisan storage:link
# - Before launch: php artisan launch:readiness --production --smoke-url=https://www.belzamora.com